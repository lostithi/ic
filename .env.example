# Optional: if set, inquiries go through Resend first.
# If missing, the site falls back to Netlify Forms automatically.
RESEND_API_KEY=re_xxxxxxxx

# Used only when RESEND_API_KEY is set
CONTACT_TO_EMAIL=hello@illegalithi.com

# Must be a verified sender/domain in Resend.
# For testing: Illegalithi Creations <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Illegalithi Creations <hello@illegalithi.com>

# Public site URL (useful for absolute links / previews)
NEXT_PUBLIC_SITE_URL=https://illegalithi.com

# Optional analytics for branding / ads measurement
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX
