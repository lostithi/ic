# Resend (required for contact form)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where inquiries are delivered
CONTACT_TO_EMAIL=hello@spinestudio.uk

# Must be a verified sender in Resend.
# Until spinestudio.uk is verified in Resend, use ONLY:
CONTACT_FROM_EMAIL=Spine Studio <onboarding@resend.dev>
# After domain verify: Spine Studio <hello@spinestudio.uk>

# Public site URL
NEXT_PUBLIC_SITE_URL=https://spinestudio.uk

# Optional analytics for branding / ads measurement
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX
