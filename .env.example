# Resend (required for contact form on Vercel)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where inquiries are delivered
CONTACT_TO_EMAIL=hello@spine.studio

# Must be a verified sender/domain in Resend.
# Local/testing: Spine <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Spine <hello@spine.studio>

# Public site URL
NEXT_PUBLIC_SITE_URL=https://spine.studio

# Optional analytics for branding / ads measurement
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX
